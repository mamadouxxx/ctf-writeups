<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cardFriendLayout"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4">
        <ImageView
            android:layout_gravity="end"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/baseline_account_circle_24"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="start"
            android:id="@+id/cardFriendPhoneNumberTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/phone_number"
            android:layout_weight="2"
            android:layout_marginStart="5dp"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/cardFriendAddOrRemoveImageView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/baseline_person_remove_24"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
