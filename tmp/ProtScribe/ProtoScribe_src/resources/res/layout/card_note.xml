<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/cardNoteTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/note_title"/>
        <TextView
            android:textSize="26sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:layout_gravity="start"
            android:id="@+id/cardNoteContentTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/note_content"
            android:layout_marginStart="5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="3">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardNoteDeleteImageView"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/baseline_delete_forever_24"
                android:layout_weight="1"
                android:contentDescription="@string/delete_note"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardNoteEditImageView"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/baseline_edit_note_24"
                android:layout_weight="1"
                android:contentDescription="@string/edit_note"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardNoteShareImageView"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/baseline_share_24"
                android:layout_weight="1"
                android:contentDescription="@string/share_note"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
