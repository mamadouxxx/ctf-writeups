<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@drawable/wallpaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="40dp"
        android:src="@mipmap/app_icon_round"
        android:contentDescription="@string/app_name"/>
    <TextView
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/edit_a_note"
        android:letterSpacing="0.04"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/note_title"/>
        <EditText
            android:textColor="@color/black"
            android:id="@+id/editNoteTitleEditText"
            android:padding="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="12"
            android:inputType="text"
            android:autofillHints="title"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/note_content"/>
        <EditText
            android:textColor="@color/black"
            android:id="@+id/editNoteContentEditText"
            android:padding="7dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="8"
            android:minLines="4"
            android:ems="12"
            android:inputType="textMultiLine"
            android:autofillHints="content"/>
        <Button
            android:textSize="24sp"
            android:layout_gravity="center"
            android:id="@+id/editNoteEditButton"
            android:paddingTop="8sp"
            android:paddingBottom="8sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/edit"
            android:textAllCaps="false"
            android:paddingStart="65sp"
            android:paddingEnd="65sp"
            android:backgroundTint="@color/blue"/>
    </LinearLayout>
</LinearLayout>
