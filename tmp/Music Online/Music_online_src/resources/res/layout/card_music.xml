<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="8dp"
    app:cardCornerRadius="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/cardMusicTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/music_title"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/grey_800"
                android:id="@+id/cardMusicArtistTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/artist"
                android:layout_toStartOf="@+id/cardMusicDashSeparationView"/>
            <TextView
                android:textColor="@color/grey_800"
                android:id="@+id/cardMusicDashSeparationView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dash_separation"
                android:layout_centerHorizontal="true"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"/>
            <TextView
                android:textColor="@color/grey_800"
                android:id="@+id/cardMusicGenreTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre"
                android:layout_toEndOf="@+id/cardMusicDashSeparationView"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:weightSum="5">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardMusicShareImageView"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/baseline_share_24"
                android:layout_weight="1"
                android:contentDescription="@string/share"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardMusicPreviousImageView"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/baseline_skip_previous_24"
                android:layout_weight="1"
                android:contentDescription="@string/previous_music"
                android:paddingStart="28dp"
                android:paddingEnd="0dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardMusicPlayImageView"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/baseline_play_circle_24"
                android:layout_weight="1"
                android:contentDescription="@string/play_music"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardMusicNextImageView"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/baseline_skip_next_24"
                android:layout_weight="1"
                android:contentDescription="@string/next_music"
                android:paddingStart="0dp"
                android:paddingEnd="28dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cardMusicFavoriteImageView"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/baseline_favorite_off_24"
                android:layout_weight="1"
                android:contentDescription="@string/favorite"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/grey_800"
            android:id="@+id/cardMusicDurationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/music_duration"
            android:textAlignment="center"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
